import pygame

dark_blue = pygame.Color(69, 98, 180)
light_blue = pygame.Color(69, 150, 180)

num_rows = 24
num_cols = 30
cell_size = 32

mine_grid = [[i%9] * num_cols for i in range(num_rows)]

window_width = num_cols * cell_size
window_height = num_rows * cell_size


pygame.init()

font_path = pygame.font.match_font("liberationmono")
font_size = cell_size - 2
font = pygame.font.Font(font_path, font_size)
numbers_text = font.render("12345678", True, "black", "gray") 
numbers_text_rect = numbers_text.get_rect()
number_width = numbers_text_rect.width / 8

screen = pygame.display.set_mode((window_width,window_height))
clock = pygame.time.Clock()
running = True

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # render game here
    screen.fill("black")

    offset_rect = pygame.Rect(0, 0, 0, 0) # size arguments not used for `dest` argument of blit
    mask_rect = pygame.Rect(0, 0, number_width, 18)
    for r in range(num_rows):
        offset_rect.top = r * cell_size
        for c in range(num_cols):
            color = light_blue if (r + c) % 2 == 0 else dark_blue
            tile = pygame.Rect(c * cell_size, r * cell_size, cell_size, cell_size)
            pygame.draw.rect(screen, color, tile)

            hint = mine_grid[r][c]
            if hint > 0:
                offset = (hint - 1) * number_width
                offset_rect.left = cell_size * c
                offset_rect
                tile.width = number_width
                screen.blit(numbers_text, offset_rect)

            

    pygame.display.flip()

    clock.tick(60) # locks the game to 60fps

pygame.quit()
